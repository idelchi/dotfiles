exclude:
  - {{ and (notInPath "docker") (notInPath "podman") }}
  - {{ not (envIsSet "DOTAI") }}
  - {{ eq (env "DOTAI") "" }}

---

commands:
  - name: coderd
    kind: function
    doc: run code container
    cmd: |
      # Get the basename of the current dir
      current_dir=$(basename "$(pwd)")
      # If CODER_DIR already is set, use it instead of the current dir
      if [ -n "${CODER_DIR}" ]; then
        current_dir="${CODER_DIR}"
      fi

      # If CODER_INIT is set to 1, run the init command first
      if [ "${CODER_INIT}" = "1" ]; then
        CODER_DIR=${current_dir} container compose --project-directory ${DOTAI} run --remove-orphans --rm init
      fi
      # Build --env-from-file flags for any present env files
      env_from_file_args=()
      for f in .env secrets.env tokens.env; do
        [ -f "${f}" ] && env_from_file_args+=(--env-from-file "${f}")
      done

      CODER_DIR=${current_dir} container compose \
        --project-directory ${DOTAI} \
        run \
        --remove-orphans \
        --rm \
        --name code-${current_dir}-${RANDOM} \
        "${env_from_file_args[@]}" \
        code

  - name: coderb
    kind: function
    doc: build code container
    cmd: |
      container compose --project-directory ${DOTAI} build code-build

  - name: coderrb
    kind: function
    doc: rebuild code container
    cmd: |
      # If the entry doesn't exist yet, create it with a timestamp
      if ! grep -q "^CACHE_BUST=" ${DOTAI}/.env; then
        echo "CACHE_BUST=$(date +%s)" >> ${DOTAI}/.env
      fi
      sed -i "s/^CACHE_BUST=.*/CACHE_BUST=$(date +%s)/" ${DOTAI}/.env
      container compose --project-directory ${DOTAI} build --no-cache code-build

  - name: codercb
    kind: function
    doc: cache bust code container
    cmd: |
      # If the entry doesn't exist yet, create it with a timestamp
      if ! grep -q "^CACHE_BUST=" ${DOTAI}/.env; then
        echo "CACHE_BUST=$(date +%s)" >> ${DOTAI}/.env
      fi
      sed -i "s/^CACHE_BUST=.*/CACHE_BUST=$(date +%s)/" ${DOTAI}/.env
      container compose --project-directory ${DOTAI} build code-build
