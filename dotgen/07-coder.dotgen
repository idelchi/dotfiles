exclude: {{ and (notInPath "docker") (notInPath "podman") }}

---

commands:
  - name: coderd
    kind: function
    doc: run code container
    cmd: |
      # Exit early with error message if ${DOTAI} isn't set
      if [ -z "${DOTAI}" ]; then
        echo "Error: DOTAI environment variable is not set. Please set it to the path of your .ai directory." >&2
        exit 1
      fi

      # Get the basename of the current dir
      current_dir=$(basename "$(pwd)")
      # If CODER_INIT is set to 1, run the init command first
      if [ "${CODER_INIT}" = "1" ]; then
        CODER_DIR=${current_dir} container compose --project-directory ${DOTAI} run --remove-orphans --rm init
      fi
      # Build --env-from-file flags for any present env files
      env_from_file_args=()
      for f in .env secrets.env tokens.env; do
        [ -f "${f}" ] && env_from_file_args+=(--env-from-file "${f}")
      done

      CODER_DIR=${current_dir} container compose \
        --project-directory ${DOTAI} \
        run \
        --remove-orphans \
        --rm \
        --name code-${current_dir}-${RANDOM} \
        "${env_from_file_args[@]}" \
        code

  - name: coderb
    kind: function
    doc: build code container
    cmd: |
      # Exit early with error message if ${DOTAI} isn't set
      if [ -z "${DOTAI}" ]; then
        echo "Error: DOTAI environment variable is not set. Please set it to the path of your .ai directory." >&2
        exit 1
      fi

      container compose --project-directory ${DOTAI} build code

  - name: coderrb
    kind: function
    doc: rebuild code container
    cmd: |
      # Exit early with error message if ${DOTAI} isn't set
      if [ -z "${DOTAI}" ]; then
        echo "Error: DOTAI environment variable is not set. Please set it to the path of your .ai directory." >&2
        exit 1
      fi

      container compose --project-directory ${DOTAI} build --no-cache code
