values:
  COMPOSE: compose.yaml
---
commands:
  - name: coderd
    doc: run code container
    cmd: |
      # Get the basename of the current dir
      current_dir=$(basename "$(pwd)")
      # If CODER_INIT is set to 1, run the init command first
      if [ "${CODER_INIT}" = "1" ]; then
        CODER_DIR=${current_dir} container compose -f ${DOTAI}/{{ .COMPOSE }} run --remove-orphans --rm init
      fi
      CODER_DIR=${current_dir} container compose -f ${DOTAI}/{{ .COMPOSE }} run --remove-orphans --rm --name code-${current_dir}-${RANDOM} code

  - name: coderb
    doc: build code container
    cmd: |
      container compose -f ${DOTAI}/{{ .COMPOSE }} build code

  - name: coderrb
    doc: rebuild code container
    cmd: container compose -f ${DOTAI}/{{ .COMPOSE }} build --no-cache code

  - name: repeatx
    doc: repeat a command multiple times
    kind: function
    cmd: |
      if [ -z "${1}" ]; then
        echo "Usage: repeatx <command> [count]"
        return 1
      fi

      command=${1}
      count=${2:-10}

      echo "repeating command '${command}' ${count} times:"

      for i in $(seq 1 "${count}"); do
        eval "${command}"
      done
