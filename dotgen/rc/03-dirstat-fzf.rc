dirstat-rm() {
  local output
  output=$(dirstat "$@" 2>&1)
  if [[ $? -ne 0 ]]; then
    echo "${output}" >&2
    return 1
  fi
  local files=$(
    awk '/^Top files:/ {flag=1; next} /^Stats/ {flag=0} flag && /^  [0-9]+\)/ {
      # Remove line number and leading whitespace
      $1 = "";
      sub(/^[ \t]+/, "");
      # Extract quoted path and size info
      match($0, /'\''([^'\'']*)'\''(.*)/, arr);
      printf "%s\t%s\n", arr[1], arr[2]
    }' <<< "$output" | awk '{a[NR]=$0} END {for(i=NR;i>0;i--) print a[i]}' |
    SHELL=%%% fzf --wrap --multi \
        --delimiter=$'\t' \
        --with-nth=1 \
        --preview-window=wrap \
        --preview='command ls -Alh --group-directories-first --time-style=long-iso --color=always -- {1} | awk "{NF--; print}"'
  )

  if [[ -n "${files}" ]]; then
    local cmd=""
    while IFS= read -r file; do
      local file_path="${file%%$'\t'*}"
      # Escape any single quotes in the path by replacing ' with '\''
      file_path="${file_path//\'/\'\\\'\'}"
      cmd+="rm -f -- '${file_path}'"$'\n'
    done <<< "$files"
    print -z "${cmd%$'\n'}"
  fi
}
