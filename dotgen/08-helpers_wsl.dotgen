exclude: {{ env "WSL_DISTRO_NAME" | empty }}

---
commands:
- name: git
  cmd: git.exe

- name: git-gui
  cmd: git-gui.exe

- name: gg
  doc: open git-gui
  cmd: git-gui.exe

- name: open
  doc: open current or specified directory in explorer
  kind: function
  cmd: |
    if [ -z "${1}" ]; then
      explorer.exe .
    else
      explorer.exe "${1}"
    fi
