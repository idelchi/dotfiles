values:
  DOTGEN_SOURCE_DIR: "{{ .CACHE_DIR }}/dotgen/{{ .SHELL }}/source/completions"
  ZINIT_PLUGINS_DIR: "{{ .HOME }}/.local/share/zinit/plugins"

  # Force rerun if dependencies change
  deps:
    # Force rerun if any tool is changed
    tools:
      task: "{{ which "task" | size }}"
      docker: "{{ which "docker" | size }}"
      helm: "{{ which "helm" | size }}"
      kubectl: "{{ which "kubectl" | size }}"
      k9s: "{{ which "k9s" | size }}"
      kubectl-fzf-completion: "{{ which "kubectl-fzf-completion" | size }}"
      godyl: "{{ which "godyl" | size }}"
      aggr: "{{ which "aggr" | size }}"
      envprof: "{{ which "envprof" | size }}"
      slot: "{{ which "slot" | size }}"
      dotgen: "{{ which "dotgen" | size }}"
      dirstat: "{{ which "dirstat" | size }}"
      podman: "{{ which "podman" | size }}"
    # Force rerun if any file is changed
    files:
      docker-fzf.rc: "{{ resolve .DOTGEN_CURRENT_DIR "rc/02-docker-fzf.rc" | size }}"
      podman-fzf.rc: "{{ resolve .DOTGEN_CURRENT_DIR "rc/03-podman-fzf.rc" | size }}"
      kubectl-fzf.rc: "{{ resolve .DOTGEN_CURRENT_DIR "rc/03-kubectl-fzf.rc" | size }}"

---

commands:
  - name: task completion
    doc: task completion
    kind: run
    cmd: task --completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/00-task.rc
    exclude: {{ notInPath "task" }}

  - name: docker completion
    doc: docker completion
    kind: run
    cmd: docker completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/01-docker.rc
    exclude: {{ notInPath "docker" }}

  - name: kubectl completion
    doc: kubectl completion
    kind: run
    cmd: kubectl completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/02-kubectl.rc
    exclude: {{ notInPath "kubectl" }}

  - name: helm completion
    doc: helm completion
    kind: run
    cmd: helm completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/03-helm.rc
    exclude: {{ notInPath "helm" }}

  - name: k9s completion
    doc: k9s completion
    kind: run
    cmd: k9s completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/04-k9s.rc
    exclude: {{ notInPath "k9s" }}

  - name: kube-fzf
    doc: Shell commands using kubectl and fzf for command-line fuzzy searching of Kubernetes Pods
    kind: raw
    cmd: |
      # If the script directory doesn't exist, clone the repository
      if [ ! -d "{{ .ZINIT_PLUGINS_DIR }}/thecasualcoder---kube-fzf" ]; then
        git clone --quiet https://github.com/thecasualcoder/kube-fzf.git "{{ .ZINIT_PLUGINS_DIR }}/thecasualcoder---kube-fzf"
      fi
      # Add the script directory to the PATH
      {{ if eq .SHELL "zsh" -}}
      path+=("{{ join .ZINIT_PLUGINS_DIR "thecasualcoder---kube-fzf" | posixPath }}")
      {{- else -}}
      export PATH="{{ join .ZINIT_PLUGINS_DIR "thecasualcoder---kube-fzf" | posixPath }}:$PATH"
      {{- end }}
    exclude: {{ or (notInPath "fzf") (notInPath "kubectl") }}


  - name: fzf-docker shortcuts
    doc: fzf-docker shortcuts
    kind: run
    cmd: sed 's/<< CONTAINER >>/docker/g' {{ .DOTGEN_CURRENT_DIR }}/rc/02-container-fzf.rc
    export_to: {{ .DOTGEN_SOURCE_DIR }}/05-docker-fzf.rc
    exclude: {{ or (notInPath "fzf") (notInPath "docker") }}
    shell:
      - zsh

  - name: fzf-podman shortcuts
    doc: fzf-podman shortcuts
    kind: run
    cmd: sed 's/<< CONTAINER >>/podman/g' {{ .DOTGEN_CURRENT_DIR }}/rc/02-container-fzf.rc
    export_to: {{ .DOTGEN_SOURCE_DIR }}/06-podman-fzf.rc
    exclude: {{ not (and (inPath "fzf") (inPath "podman") (notInPath "docker")) }}
    shell:
      - zsh

  - name: godyl
    doc: godyl completions
    kind: run
    cmd: godyl completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/07-godyl.rc
    exclude: {{ notInPath "godyl" }}

  - name: aggr
    doc: aggr completions
    kind: run
    cmd: aggr --shell-completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/08-aggr.rc
    exclude: {{ notInPath "aggr" }}

  - name: envprof
    doc: envprof completions
    kind: run
    cmd: envprof completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/09-envprof.rc
    exclude: {{ notInPath "envprof" }}

  - name: slot
    doc: slot completions
    kind: run
    cmd: slot completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/10-slot.rc
    exclude: {{ notInPath "slot" }}

  - name: dotgen
    doc: dotgen completions
    kind: run
    cmd: dotgen completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/11-dotgen.rc
    exclude: {{ notInPath "dotgen" }}

  - name: dirstat
    doc: dirstat completions
    kind: run
    cmd: dirstat --shell-completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/12-dirstat.rc
    exclude: {{ notInPath "dirstat" }}

  - name: podman completion
    doc: podman completion
    kind: run
    cmd: podman completion "{{ .SHELL }}"
    export_to: {{ .DOTGEN_SOURCE_DIR }}/13-podman.rc
    exclude: {{ notInPath "podman" }}
