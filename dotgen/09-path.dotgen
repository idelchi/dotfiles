values:
  LOCAL_BIN: "{{ .HOME }}/.local/bin"
  KREW_BIN: "{{ .HOME }}/.krew/bin"
  CARGO_BIN: "{{ .HOME }}/.cargo/bin"

---

commands:
  - name: local
    kind: raw
    cmd: |
      posix_path="{{ posixPath .LOCAL_BIN }}"
      {{ if eq .SHELL "zsh" -}}
      path+=("${posix_path}")
      {{- else -}}
      export PATH="${posix_path}:$PATH"
      {{- end }}
    exclude: {{ not (exists .LOCAL_BIN) }}

  - name: krew
    kind: raw
    cmd: |
      posix_path="{{ posixPath .KREW_BIN }}"
      {{ if eq .SHELL "zsh" -}}
      path+=("${posix_path}")
      {{- else -}}
      export PATH="${posix_path}:$PATH"
      {{- end }}
    exclude: {{ not (exists .KREW_BIN) }}

  - name: cargo
    kind: raw
    cmd: |
      posix_path="{{ posixPath .CARGO_BIN }}"
      {{ if eq .SHELL "zsh" -}}
      path+=("${posix_path}")
      {{- else -}}
      export PATH="${posix_path}:$PATH"
      {{- end }}
    exclude: {{ not (exists .CARGO_BIN) }}
