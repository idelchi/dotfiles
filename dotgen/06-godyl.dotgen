commands:
  - name: godyld
    doc: download and install godyl
    cmd: |
      curl -sSL https://raw.githubusercontent.com/idelchi/godyl/refs/heads/main/install.sh | sh -s -- -d ${GODYL_OUTPUT_DIR}

  - name: godylu
    doc: update godyl to the latest version
    cmd: godyl update --pre --force

  - name: godyla
    doc: install all tools from godyl dump
    cmd: godyl dump tools -e | godyl i --strategy sync - --output=${GODYL_OUTPUT_DIR}

  - name: godyli
    doc: install all idelchi tools from godyl dump
    cmd: godyl dump tools -e | godyl i --tags "idelchi/*" --pre - --output=${GODYL_OUTPUT_DIR}

  - name: godylgit
    doc: install all gitlab related tools from godyl dump
    cmd: godyl -j=2 -d ${GODYL_BASE_DIR}/defaults.yml i --strategy force --output=${GODYL_OUTPUT_DIR} ${GODYL_BASE_DIR}/gitlab.yml
