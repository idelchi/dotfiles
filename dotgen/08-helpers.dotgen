commands:
  - name: repeatx
    doc: repeat a command multiple times
    kind: function
    cmd: |
      if [ -z "${1}" ]; then
        echo "Usage: repeatx <command> [count]"
        return 1
      fi

      command=${1}
      count=${2:-10}

      echo "repeating command '${command}' ${count} times:"

      for i in $(seq 1 "${count}"); do
        eval "${command}"
      done

  - name: pe
    doc: print environment variables
    kind: alias
    cmd: |
      printenv
